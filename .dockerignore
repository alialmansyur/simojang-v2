# Exclude local secrets, dev artifacts, logs, caches, and frontend node_modules from Docker build context
.git
.gitignore
**/*.env
**/.env.*
!apps/admin/.env.example

apps/admin/writable/logs/*
!apps/admin/writable/logs/.gitkeep
!apps/admin/writable/logs/index.html
apps/admin/writable/session/*
!apps/admin/writable/session/.gitkeep
!apps/admin/writable/session/index.html
apps/admin/writable/cache/*
!apps/admin/writable/cache/.gitkeep
!apps/admin/writable/cache/index.html
apps/admin/writable/debugbar/*

apps/admin/tests
apps/admin/phpunit.xml*
apps/admin/clean_data.json
apps/admin/vendor_backup
apps/admin/pdf_tables.json
apps/admin/prompt.md
apps/admin/builds
apps/frontend/node_modules
apps/frontend/dist
apps/frontend/.vite
data
docs
backup*
*.sql
