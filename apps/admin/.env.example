#--------------------------------------------------------------------
# CodeIgniter 4 Environment Configuration (API-Only Backend)
# Copy this file to .env on the target server and fill in real secrets.
# NEVER commit .env or production credentials to version control.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://your-api-domain.example.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = simojang
database.default.username = db_user
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# SECURITY & JWT
#--------------------------------------------------------------------
JWT_TOKEN_SECRET = 'CHANGE_ME_USE_64_CHAR_RANDOM_HEX_SECRET'
CORS_ALLOWED_ORIGINS = 'https://your-frontend-domain.example.com'

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key = ''

#--------------------------------------------------------------------
# SESSION & CACHE
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
cache.handler = 'file'
