# database.default.database = simojang
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port     = 3306

# --------------------------------------------------------------------
# 5. SECURITY & JWT (JSON WEB TOKEN)
# --------------------------------------------------------------------
# Kunci rahasia untuk enkripsi token login JWT (Gunakan token acak 64 karakter)
JWT_TOKEN_SECRET = '5963a3e5bee3a4b546178bd39879e8797152b678'

# Kunci enkripsi bawaan CodeIgniter (Opsional)
encryption.key = 'hex2bin:84f1a6b0c2e3d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9'

# --------------------------------------------------------------------
# 6. SESSION & STORAGE
# --------------------------------------------------------------------
app.sessionDriver   = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionSavePath = null
app.sessionCookieName = 'simojang_session'
app.sessionExpiration = 7200

# Root folder penyimpanan berkas upload terpusat (default: writable/uploads/)
# UPLOAD_ROOT_PATH = '/var/www/html/writable/uploads/'

# --------------------------------------------------------------------
# 7. LOGGING & DEBUGGING
# --------------------------------------------------------------------
# Threshold: 0 = Nonaktif, 1 = Error Only, 2 = Debug + Error, 4 = All Messages
# Rekomendasi server: 1 (Error Only). Rekomendasi lokal: 4 (Semua).
logger.threshold = 1

