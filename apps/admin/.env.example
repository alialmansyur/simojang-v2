# ====================================================================
# SIMOJANG V2 - CODEIGNITER 4 BACKEND ENVIRONMENT CONFIGURATION
# ====================================================================
# Salin file ini menjadi .env di server:
#   cp apps/admin/.env.example apps/admin/.env
# ====================================================================

# --------------------------------------------------------------------
# 1. ENVIRONMENT MODE
# --------------------------------------------------------------------
# Nilai: 'production' (untuk server rilis/live) atau 'development' (untuk debug lokal)
CI_ENVIRONMENT = production
# CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# 2. APPLICATION BASE URL & TIMEZONE
# --------------------------------------------------------------------
# Pilihan Base URL:
# A. Server Produksi (VirtualHost Apache HTTPS):
app.baseURL = 'https://kanreg3.id/simojang-api/'

# B. Server Testing / Staging:
# app.baseURL = 'https://kanreg3.id/simojang-api/'

# C. Lokal Docker (Port 8401/8402):
# app.baseURL = 'http://localhost:8401/'

# D. Lokal PHP Spark (Port 8080):
# app.baseURL = 'http://localhost:8080/'

app.appTimezone = 'Asia/Jakarta'
app.forceGlobalSecureRequests = false

# --------------------------------------------------------------------
# 3. CORS ALLOWLIST (Domain Frontend yang diizinkan mengakses API)
# --------------------------------------------------------------------
# Pisahkan dengan koma jika lebih dari satu origin:
CORS_ALLOWED_ORIGINS = 'https://kanreg3.id,http://localhost:8401,http://localhost:5173'

# --------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# --------------------------------------------------------------------
# [PILIHAN 1: SERVER PRODUKSI KANREG III]
database.default.hostname = 150.165.10.107
database.default.database = simojang_prod
database.default.username = 1nkakanre3
database.default.password = 1nk4jaya@2024!
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306

# [PILIHAN 2: LOKAL PC (via Docker host)]
# database.default.hostname = host.docker.internal
# database.default.database = simojang
# database.default.username = root
# database.default.password = local@database#
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
