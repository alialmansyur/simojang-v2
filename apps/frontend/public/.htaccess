<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika berkas atau direktori fisik memang ada, sajikan langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Jika bukan berkas fisik (seperti /login, /admin/dashboard), lempar ke index.html untuk ditangani React Router
  RewriteRule ^ index.html [L]
</IfModule>
