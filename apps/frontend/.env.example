# SIMOJANG Frontend Environment
# Biarkan VITE_API_BASE_URL kosong agar menggunakan origin yang sama / proxy Vite saat development
VITE_API_BASE_URL=

# Target proxy Vite dev server ke Backend CodeIgniter 4:
# - Lokal manual (php spark serve): http://localhost:8080
# - Lokal via Docker Nginx:        http://localhost:8105
VITE_API_PROXY_TARGET=http://localhost:8080
